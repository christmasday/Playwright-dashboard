# Frontend Environment Variables
VITE_APP_NAME=Playwright Dashboard
VITE_APP_VERSION=2.0.0
VITE_THEME=default
VITE_ENABLE_REAL_TIME=true
VITE_ENABLE_ANALYTICS=false
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_URL=http://localhost:3001/api
VITE_WS_URL=ws://localhost:3001

# Backend Environment Variables
NODE_ENV=development
PORT=3001
SELF_HOSTED_COMMUNITY=true

# Database Configuration (PostgreSQL / Supabase)
# Option 1: Local PostgreSQL
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/playwright_dashboard
# Option 2: Supabase Cloud
DATABASE_URL=postgresql://postgres.your-project:your-password@your-host.pooler.supabase.com:6543/postgres
SSL_ENABLED=true
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-key

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Authentication (JWT-based)
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Webhook Secrets
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret-change-this
GITLAB_WEBHOOK_TOKEN=your-gitlab-webhook-token-change-this
JENKINS_WEBHOOK_TOKEN=your-jenkins-token-change-this

# Email (Resend)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@example.com

# Storage (local, s3, gcs)
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# Dashboard API Key for Ingestion
DASHBOARD_API_KEY=your-dashboard-api-key
DASHBOARD_PROJECT="default"
